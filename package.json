{
  "name": "new-day",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm --workspace=backend run dev\" \"npm --workspace=frontend run dev\"",
    "build": "npm --workspace=frontend run build && npm --workspace=backend run build",
    "start:backend": "npm --workspace=backend run start",
    "start:frontend": "npm --workspace=frontend run dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
